{
  "expo": {
    "name": "AI Agents Company",
    "slug": "agentharbor",
    "version": "1.5.1",
    "orientation": "portrait",
    "backgroundColor": "#000000",
    "icon": "./assets/images/app-mark.png",
    "scheme": "agentharbor",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "org.agentharbor.mobile",
      "icon": "./assets/images/app-mark.png"
    },
    "android": {
      "package": "org.agentharbor.mobile",
      "icon": "./assets/images/app-mark.png",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/app-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/app-mark.png",
          "imageWidth": 150
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
