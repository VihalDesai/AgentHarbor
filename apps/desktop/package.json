{
  "name": "agentharbor-desktop",
  "version": "1.0.0",
  "description": "AgentHarbor desktop application",
  "author": "AgentHarbor contributors",
  "main": "main.cjs",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "41.10.7",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.agentharbor.desktop",
    "productName": "AgentHarbor",
    "win": { "icon": "assets/icon.ico", "target": ["portable"], "artifactName": "AgentHarbor-${version}-Windows.exe" },
    "directories": { "output": "../../releases/desktop" },
    "files": ["main.cjs", "preload.cjs"],
    "extraResources": [{ "from": "../app/dist", "to": "app" }]
  }
}
