{
  "name": "agentharbor-desktop",
  "version": "1.5.1",
  "description": "AI Agents Company desktop application",
  "author": "AgentHarbor contributors",
  "main": "main.cjs",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "org.agentharbor.desktop",
    "productName": "AI Agents Company",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable"
      ],
      "artifactName": "AI Agents Company-${version}-Windows.exe"
    },
    "directories": {
      "output": "../../releases/desktop"
    },
    "files": [
      "main.cjs",
      "preload.cjs"
    ],
    "extraResources": [
      {
        "from": "../app/dist",
        "to": "app"
      }
    ]
  }
}
