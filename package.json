{
  "name": "agentharbor",
  "version": "1.5.2",
  "private": true,
  "description": "A local-first, open-source agent workspace for desktop and Android.",
  "license": "MIT",
  "workspaces": [
    "apps/app",
    "apps/desktop"
  ],
  "scripts": {
    "android": "npm --prefix apps/app start -- --lan",
    "web": "npm --prefix apps/app run web",
    "web:build": "npm --prefix apps/app run export:web",
    "desktop": "npm --prefix apps/desktop start",
    "desktop:build": "npm run web:build && npm --prefix apps/desktop run dist:win"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  },
  "devDependencies": {
    "decode-uri-component": "file:./patches/decode-uri-component-compat",
    "zod": "4.6.7"
  },
  "overrides": {
    "node-forge": "1.4.2",
    "expo": {
      "@expo/cli": {
        "zod": "$zod"
      }
    },
    "expo-router": {
      "query-string": {
        "decode-uri-component": "$decode-uri-component"
      }
    }
  }
}
